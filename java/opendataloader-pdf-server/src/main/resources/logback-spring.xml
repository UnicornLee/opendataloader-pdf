<?xml version="1.0" encoding="UTF-8"?>

<configuration debug="true" scan="true">

    <springProperty scope="context" name="log.level" source="log.level" defaultValue="DEBUG"/>
    <springProperty scope="context" name="log.appender" source="log.appender" defaultValue="file"/>
    <springProperty scope="context" name="log.home" source="log.home" defaultValue="service_ticket"/>
    <springProperty scope="context" name="log.stash.addresses" source="log.stash.addresses" defaultValue=""/>

    <!--
      Suppress known-benign PDFBox 3.0.4 / veraPDF 1.31.x recover-and-continue
      messages that fire on every page of malformed PDFs ("colorSpace is null,
      will be rendered as transparency", "name for 'gs' operator not found in
      resources: /GSx", "Operator X has too few operands", "Missing width of
      glyph with code X in font Y"). See
      org.opendataloader.pdf.server.logging.PdfBoxNoiseFilter for the exact
      match list and rationale. Filtering on message content (not logger name)
      keeps unrelated real errors from the same loggers visible.
    -->
    <turboFilter class="org.opendataloader.pdf.server.logging.PdfBoxNoiseFilter"/>

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder charset="UTF-8">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%-5level] [%X{tid}] %logger %M - %msg%n</pattern>
        </encoder>
    </appender>

    <springProfile name="dev">
        <appender name="file" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>${log.home}/%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>60</maxHistory>
            </rollingPolicy>
            <encoder charset="UTF-8">
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%-5level] [%X{tid}] %logger %M - %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="prod,prod-inc,prod-hk">
        <appender name="stash" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
            <destination>${log.stash.addresses}</destination>
            <keepAliveDuration>5 minutes</keepAliveDuration>
            <reconnectionDelay>1 second</reconnectionDelay>
            <writeBufferSize>16384</writeBufferSize>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeCallerData>true</includeCallerData>
                <customFields>{"type":"jetty_log","program":"opendataloader-pdf-server"}
                </customFields>
            </encoder>
        </appender>
    </springProfile>
    <springProfile name="prepub-sz,prepub-hk">
        <appender name="stash" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
            <destination>${log.stash.addresses}</destination>
            <keepAliveDuration>5 minutes</keepAliveDuration>
            <reconnectionDelay>1 second</reconnectionDelay>
            <writeBufferSize>16384</writeBufferSize>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeCallerData>true</includeCallerData>
                <customFields>{"type":"jetty_log","program":"opendataloader-pdf-server"}
                </customFields>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="sim">
        <appender name="stash" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
            <destination>${log.stash.addresses}</destination>
            <keepAliveDuration>5 minutes</keepAliveDuration>
            <reconnectionDelay>1 second</reconnectionDelay>
            <writeBufferSize>16384</writeBufferSize>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeCallerData>true</includeCallerData>
                <customFields>{"type":"jetty_log","program":"opendataloader-pdf-server-sim"}
                </customFields>
            </encoder>
        </appender>
    </springProfile>

    <root level="${log.level}">
        <appender-ref ref="console" />
        <appender-ref ref="${log.appender}" />
    </root>

    <logger name="org.springframework" level="WARN"></logger>
    <logger name="com.netflix" level="WARN"></logger>
    <logger name="org.dozer" level="WARN"></logger>
    <logger name="org.hibernate" level="WARN"></logger>
    <logger name="org.mybatis" level="WARN"></logger>
    <logger name="org.apache" level="WARN"></logger>
    <logger name="io.lettuce" level="WARN"></logger>
    <logger name="reactor.netty.http.server" level="WARN"></logger>
    <logger name="ma.glasnost.orika" level="WARN"></logger>
    <logger name="org.eclipse.jetty.http" level="WARN"></logger>
    <logger name="reactor.util" level="WARN"></logger>

    <!--    <logger name="org.apache.http" level="WARN"></logger>-->

</configuration>
